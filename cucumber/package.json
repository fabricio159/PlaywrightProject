{
  "name": "playwrightproject-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "Same tests as ../tests and ../bdd, run with @cucumber/cucumber + Playwright",
  "type": "module",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('reports/allure-results',{recursive:true,force:true})\"",
    "test": "cucumber-js",
    "test:headed": "HEADED=1 cucumber-js",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.0",
    "allure": "^3.33.0",
    "allure-cucumberjs": "^3.14.0",
    "allure-js-commons": "^3.14.0",
    "dotenv": "^18.0.7"
  }
}
