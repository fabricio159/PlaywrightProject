{
  "name": "playwrightproject",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "allure:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "test:allure": "npm run allure:clean && allure run --results-dir allure-results -- playwright test",
    "test:bdd": "bddgen --config playwright.bdd.config.js && playwright test --config playwright.bdd.config.js",
    "test:bdd:headed": "bddgen --config playwright.bdd.config.js && playwright test --config playwright.bdd.config.js --headed",
    "test:bdd:ui": "bddgen --config playwright.bdd.config.js && playwright test --config playwright.bdd.config.js --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
