# Copy to .env and fill in values
BASE_URL=https://www.saucedemo.com/
# API under test for tests/api (npm run test:api)
API_URL=https://restful-booker.herokuapp.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
# Browser(s) to run: all, chromium, firefox, webkit (comma-separated)
BROWSER=chromium
PARALLEL_NODES=2
# Tag(s) to run: all, or e.g. @smoke,@login (comma-separated, runs tests with any of them)
TAGS=all
